{
  "manifest_version": 3,
  "name": "安全处理助手",
  "version": "1.0",
  "description": "安全问题处理插件",
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "安全助手"
  },
  
  "options_page": "src/options/options.html",
  
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  
  "permissions": [
    "activeTab", 
    "storage", 
    "notifications",
    "tabs",
    "webRequest"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["test/*", "test/**/*"],
      "matches": ["<all_urls>"]
    }
  ]
}