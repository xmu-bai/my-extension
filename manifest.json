{
  "manifest_version": 3,
  "name": "auto-find-xss",
  "version": "1.0.0",
  "description": "自动检测网页中的 XSS 漏洞",
  "author": "Black-Hole",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"], 
      "js": ["src/content-scripts/content.js"],
      "run_at": "document_idle", 
      "all_frames": true
    }
  ],

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true 
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },

  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "notifications",
    "scripting"
  ],

  "host_permissions": ["<all_urls>"],

  "web_accessible_resources": [
    {
      "resources": ["src/*"],
      "matches": ["<all_urls>"]
    }
  ]
}