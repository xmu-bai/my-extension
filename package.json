    "dev": "rollup -c rollup.config.js -w",

    "build": "rollup -c rollup.config.js --environment NODE_ENV:production",

    "build:background": "rollup -c rollup.config.js --environment MODULE:background",
    "build:content": "rollup -c rollup.config.js --environment MODULE:content-scripts",
    "build:options": "rollup -c rollup.config.js --environment MODULE:options",
    "build:popup": "rollup -c rollup.config.js --environment MODULE:popup",

    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",

    "type-check": "tsc --noEmit",

    "clean": "rimraf dist"
  },
  "dependencies": {
    "axios": "^1.6.0", 
    "uuid": "^9.0.1",
